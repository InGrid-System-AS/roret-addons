<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Selskapsisolasjon for l10n.no.mvamelding (lagt til 2026-08-31).

            Husmønsteret er STRUKTURELT: selskapsisolasjon håndheves av en
            global ir.rule på meldingsmodellen, ikke av sjekker inne i hver
            action. Søstermodulen l10n_no_account_skattemelding har hatt
            denne regelen hele tiden (skattemelding_security.xml) — MVA-
            modulen manglet den, og det var årsaken til produksjonsfeilen
            2026-08-31: meldingen var synlig og klikkbar fra feil selskap,
            mens ALLE account.*-oppslagene bak knappene ble filtrert bort av
            kjernens egne selskapsregler. Resultatet var en misvisende
            diagnose («er den norske kontoplanen installert?») i stedet for
            «du står i feil selskap».

            `company_ids` i domenet er env.companies.ids — de AKTIVE
            selskapene fra velgeren øverst til høyre (ir_rule.py:49), ikke
            alle selskaper brukeren har tilgang til. Det er nettopp den
            samme størrelsen kjernens account.*-regler bruker, så meldingen
            og tallene den bygger på blir nå synlige under ett og samme
            vilkår.

            global=True: gjelder uavhengig av brukerens grupper, som er
            vanlig praksis for selskapsisolasjon.

            Arvede utvidelser (oppgjør, kvittering, submit, validate, xml og
            betalingsbroene) bruker samme model_id og dekkes automatisk —
            ir.rule slår inn på modell-laget.

            Cron-jobbene (_cron_poll_pending_receipts,
            _cron_complete_submissions) kjører som superbruker og er derfor
            ikke berørt: ir.rule hoppes over under env.su, så de fortsetter
            å se meldinger på tvers av selskaper.
        -->
        <record id="l10n_no_mvamelding_rule_multicompany" model="ir.rule">
            <field name="name">l10n.no.mvamelding: multi-company</field>
            <field name="model_id" ref="model_l10n_no_mvamelding"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
            Selskapsisolasjon for l10n.no.mvamelding.merknad.

            EGEN regel, med vilje: ir.rule slår inn på modell-laget og
            cascader IKKE fra forelder til barnemodell. Merknaden er en
            selvstendig modell med egen tabell, så uten denne ville
            merknadene vært lesbare fra feil selskap selv om selve
            meldingen ikke er det. Samme observasjon står i en tidligere
            review av skattemelding-modulen.

            Innholdet er ikke uskyldig: merknaden er fritekst som forklarer
            selskapets avgiftsforhold til Skatteetaten — typisk hvorfor et
            fradrag er tilbakeført. Den hører ikke hjemme hos et
            søsterselskap.

            `company_id` på modellen er en LAGRET related fra
            mvamelding_id.company_id, så domenet kan bruke den direkte og
            treffer indeks — ingen join gjennom forelderen.
        -->
        <record id="l10n_no_mvamelding_merknad_rule_multicompany" model="ir.rule">
            <field name="name">l10n.no.mvamelding.merknad: multi-company</field>
            <field name="model_id" ref="model_l10n_no_mvamelding_merknad"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
