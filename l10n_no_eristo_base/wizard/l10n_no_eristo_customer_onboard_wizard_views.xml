<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_no_eristo_customer_onboard_wizard_form" model="ir.ui.view">
        <field name="name">l10n.no.eristo.customer.onboard.wizard.form</field>
        <field name="model">l10n.no.eristo.customer.onboard.wizard</field>
        <field name="arch" type="xml">
            <form string="Onboard selskap hos Eristo">
                <field name="state" widget="statusbar"
                       statusbar_visible="start,done,error"/>

                <!-- Steg 1: Start -->
                <group invisible="state != 'start'">
                    <div colspan="2">
                        <h2>Onboard selskap mot Eristo Token Service</h2>
                        <p>
                            Dette oppretter en kunde-rad i Eristos token-tjeneste
                            og genererer en API-nøkkel for selskapet. Nøkkelen
                            lagres automatisk i selskapets Eristo-tilkobling og
                            vises i klartekst ett sted etter onboarding —
                            Eristo lagrer kun en hash, så ta vare på den hvis
                            du trenger den senere.
                        </p>
                        <p>
                            Etter onboarding må daglig leder godkjenne
                            scopes (skattemelding, a-melding etc.) i Altinn-portalen
                            — det skjer via egne wizards i hver Skatteetaten-modul.
                        </p>
                    </div>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="company_name"/>
                        <field name="orgnr"
                               placeholder="9 siffer, eks. 917191239"/>
                        <field name="environment"/>
                    </group>
                </group>

                <!-- Steg 2: Done -->
                <group invisible="state != 'done'">
                    <div colspan="2">
                        <h2>✓ Onboarding fullført</h2>
                        <p>
                            <field name="company_name" readonly="1" nolabel="1" class="oe_inline"/>
                            er nå registrert som kunde av Eristo Token Service.
                            API-nøkkelen er lagret på selskapsraden.
                        </p>
                        <div class="alert alert-warning" role="alert">
                            <strong>Ta vare på API-nøkkelen nedenfor</strong>
                            — dette er eneste gang den vises i klartekst.
                            Eristo har kun en SHA-256-hash av den.
                        </div>
                    </div>
                    <group>
                        <field name="api_key_display" readonly="1"
                               widget="CopyClipboardChar"/>
                        <field name="customer_id_display" readonly="1"/>
                    </group>
                    <div colspan="2">
                        <p>
                            <strong>Neste steg:</strong>
                            Gå til Settings → Companies → Skatteetaten-tilkobling
                            og klikk "Test Eristo-forbindelse" for å verifisere
                            at nøkkelen virker. Deretter aktiver hver Skatteetaten-
                            tjeneste (skattemelding, a-melding etc.) via sin egen
                            Altinn-onboarding-wizard.
                        </p>
                    </div>
                </group>

                <!-- Error -->
                <group invisible="state != 'error'">
                    <field name="error_message" readonly="1" nolabel="1"/>
                </group>

                <footer>
                    <button name="action_onboard"
                            string="Onboard selskap"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'start'"
                            groups="base.group_system"/>
                    <button string="Lukk"
                            class="btn-primary"
                            special="cancel"
                            invisible="state != 'done'"/>
                    <button string="Avbryt"
                            class="btn-secondary"
                            special="cancel"
                            invisible="state == 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_no_eristo_customer_onboard_wizard" model="ir.actions.act_window">
        <field name="name">Onboard selskap hos Eristo</field>
        <field name="res_model">l10n.no.eristo.customer.onboard.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_company"/>
        <field name="binding_view_types">form</field>
        <!-- Group-restriksjon i Odoo 19: ir.actions.act_window har ikke
             lenger 'groups_id'-felt. Tilgang sikres via:
               1) Knappen på res.company-formet har groups="base.group_system"
               2) ir.model.access.csv låser TransientModel'en til base.group_system
               3) action_onboard() gjør has_group-sjekk eksplisitt -->
    </record>
</odoo>
