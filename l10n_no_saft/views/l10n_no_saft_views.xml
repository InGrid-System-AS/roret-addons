<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_no_saft_export_form" model="ir.ui.view">
        <field name="name">l10n.no.saft.export.form</field>
        <field name="model">l10n.no.saft.export</field>
        <field name="arch" type="xml">
            <form string="SAF-T Financial">
                <header>
                    <button name="action_generate" type="object"
                            string="Generer SAF-T-fil" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status"
                         invisible="state != 'generated'">
                        Fila lastes opp i Altinn (RF-1363) når Skatteetaten
                        ber om den. Verifiser gjerne med Skatteetatens
                        XML-validator først.
                    </div>
                    <group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="kontakt_fornavn"/>
                            <field name="kontakt_etternavn"/>
                            <field name="saft_file" filename="saft_filename"
                                   invisible="not saft_file"/>
                            <field name="saft_filename" invisible="1"/>
                            <field name="generated_at"
                                   invisible="not generated_at"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_no_saft_export_list" model="ir.ui.view">
        <field name="name">l10n.no.saft.export.list</field>
        <field name="model">l10n.no.saft.export</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'generated'"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="l10n_no_saft_export_action" model="ir.actions.act_window">
        <field name="name">SAF-T Financial</field>
        <field name="res_model">l10n.no.saft.export</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_no_saft"
              name="SAF-T Financial"
              parent="account.menu_finance_reports"
              action="l10n_no_saft_export_action"
              sequence="99"/>
</odoo>
